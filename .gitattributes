# 统一换行符为 LF，避免 Windows 贡献者提交 CRLF 后产生大量无意义 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.docx binary
*.pdf  binary
*.zip  binary

# 测试样本与语料：保持原样，防止 Git 归一化破坏内容
test/fixtures/*.docx binary
test/corpus/**/*.txt text eol=lf

# Windows 批处理脚本需要 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
